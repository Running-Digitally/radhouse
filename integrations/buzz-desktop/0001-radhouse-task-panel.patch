index 0000000..1132984
--- /dev/null
+++ b/desktop/src-tauri/src/commands/radhouse.rs
@@ -0,0 +1,363 @@
+//! Bounded native transport for one explicitly configured Radhouse controller.
+//! The existing Radhouse cookie, Origin and CSRF checks remain in force.
+
+use std::sync::LazyLock;
+use std::time::Duration;
+
+use base64::{engine::general_purpose::STANDARD as BASE64, Engine as _};
+use nostr::{EventBuilder, JsonUtil, Keys, Kind, Tag};
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use tauri::State;
+use tokio::sync::Mutex;
+
+use crate::app_state::AppState;
+use crate::relay::relay_api_base_url_with_override;
+
+mod enrollment;
+pub use enrollment::radhouse_enroll_agent;
+
+struct Session {
+    scope: String,
+    cookie: Option<String>,
+}
+
+static SESSION: LazyLock<Mutex<Option<Session>>> = LazyLock::new(|| Mutex::new(None));
+
+#[derive(Serialize)]
+/// Public origins shown in the native panel; contains no credentials.
+pub struct RadhouseConfiguration {
+    origin: String,
+    relay: String,
+}
+
+#[derive(Serialize)]
+/// Bounded controller response, excluding cookies and authentication headers.
+pub struct RadhouseResponse {
+    status: u16,
+    body: String,
+}
+
+fn config() -> Result<(String, String, String), String> {
+    let origin = option_env!("BUZZ_RADHOUSE_ORIGIN").ok_or("Radhouse is not configured")?;
+    let relay =
+        option_env!("BUZZ_RADHOUSE_RELAY_ORIGIN").ok_or("Radhouse relay is not configured")?;
+    let key =
+        option_env!("BUZZ_RADHOUSE_RELAY_PUBKEY").ok_or("Radhouse relay key is not configured")?;
+    for value in [origin, relay] {
+        let url = reqwest::Url::parse(value).map_err(|_| "Invalid Radhouse origin")?;
+        if url.scheme() != "https"
+            || url.host_str().is_none()
+            || !url.username().is_empty()
+            || url.password().is_some()
+            || url.query().is_some()
+            || url.fragment().is_some()
+            || url.path() != "/"
+            || value.ends_with('/')
+        {
+            return Err("Radhouse requires an exact HTTPS origin".into());
+        }
+    }
+    if key.len() != 64
+        || !key
+            .bytes()
+            .all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase())
+    {
+        return Err("Invalid Radhouse relay key".into());
+    }
+    Ok((origin.into(), relay.into(), key.into()))
+}
+
+fn identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 200
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || b"._:-".contains(&c))
+}
+
+fn allowed_path(method: &str, path: &str) -> bool {
+    let route = path.split('?').next().unwrap_or_default();
+    if path.len() > 2048 || path.contains(['#', '\\', '\r', '\n']) {
+        return false;
+    }
+    let parts: Vec<_> = route.split('/').collect();
+    match (method, parts.as_slice()) {
+        ("GET", ["", "projects" | "work-home"]) => true,
+        ("GET" | "POST", ["", "agent-enrollment"]) => true,
+        ("GET", ["", "conversations"]) => true,
+        ("GET" | "POST", ["", "conversations", id, "messages"]) => identifier(id),
+        ("GET", ["", "auth", "session"]) => true,
+        ("POST", ["", "auth", "login" | "logout" | "reauthenticate"]) => true,
+        ("POST", ["", "tasks"]) => true,
+        ("GET", ["", "tasks", id]) => identifier(id),
+        ("GET", ["", "tasks", id, "events" | "result" | "publication" | "review-audience"]) => {
+            identifier(id)
+        }
+        (
+            "POST",
+            ["", "tasks", id, "cancel" | "pause" | "resume" | "review" | "guidance" | "permission"],
+        ) => identifier(id),
+        ("POST", ["", "reviews", id, "publish"]) => identifier(id),
+        _ => false,
+    }
+}
+
+fn signed(
+    keys: &Keys,
+    url: &str,
+    method: &str,
+    body: &str,
+    extra: Vec<Vec<String>>,
+) -> Result<String, String> {
+    let mut values = vec![
+        vec!["u".into(), url.into()],
+        vec!["method".into(), method.into()],
+        vec![
+            "payload".into(),
+            hex::encode(Sha256::digest(body.as_bytes())),
+        ],
+        vec!["nonce".into(), uuid::Uuid::new_v4().to_string()],
+    ];
+    values.extend(extra);
+    let tags = values
+        .into_iter()
+        .map(|value| Tag::parse(value).map_err(|_| "Invalid Radhouse request".to_string()))
+        .collect::<Result<Vec<_>, _>>()?;
+    let event = EventBuilder::new(Kind::Custom(27235), "")
+        .tags(tags)
+        .sign_with_keys(keys)
+        .map_err(|_| "Could not sign Radhouse request")?;
+    Ok(format!("Nostr {}", BASE64.encode(event.as_json())))
+}
+
+/// Return public connection configuration only for the admitted community.
+#[tauri::command]
+pub fn radhouse_config(state: State<'_, AppState>) -> Result<RadhouseConfiguration, String> {
+    let (origin, relay, _) = config()?;
+    if relay_api_base_url_with_override(&state).trim_end_matches('/') != relay {
+        return Err("Radhouse is not configured for this community".into());
+    }
+    Ok(RadhouseConfiguration { origin, relay })
+}
+
+/// Forget the native-only cookie when this identity's task panel closes.
+#[tauri::command]
+pub async fn radhouse_clear_session(pubkey: String) {
+    let mut guard = SESSION.lock().await;
+    if guard
+        .as_ref()
+        .is_some_and(|session| session.scope.starts_with(&format!("{pubkey}|")))
+    {
+        *guard = None;
+    }
+}
+
+/// Perform one signed operator request; never follows redirects or retries.
+#[tauri::command]
+pub async fn radhouse_request(
+    path: String,
+    method: String,
+    body: String,
+    channel_id: String,
+    csrf: String,
+    state: State<'_, AppState>,
+) -> Result<RadhouseResponse, String> {
+    operator_request(path, method, body, channel_id, csrf, &state).await
+}
+
+async fn operator_request(
+    path: String,
+    method: String,
+    body: String,
+    channel_id: String,
+    csrf: String,
+    state: &AppState,
+) -> Result<RadhouseResponse, String> {
+    crate::egress_guard::assert_no_key_backup(&body, "Radhouse operator request")?;
+    let (origin, relay, relay_key) = config()?;
+    if !allowed_path(&method, &path)
+        || !identifier(&channel_id)
+        || body.len() > 262_144
+        || csrf.len() > 128
+    {
+        return Err("Radhouse request is outside the operator contract".into());
+    }
+    if relay_api_base_url_with_override(state).trim_end_matches('/') != relay {
+        return Err("The active community changed".into());
+    }
+    let keys = state.signing_keys()?;
+    let scope = format!("{}|{}", keys.public_key().to_hex(), relay);
+    let mut guard = SESSION.lock().await;
+    if guard.as_ref().is_none_or(|session| session.scope != scope) {
+        *guard = Some(Session {
+            scope: scope.clone(),
+            cookie: None,
+        });
+    }
+    let query = format!(
+        r##"[{{"kinds":[39002],"authors":["{relay_key}"],"#d":["{channel_id}"],"limit":1}}]"##
+    );
+    let membership = signed(&keys, &format!("{relay}/query"), "POST", &query, vec![])?;
+    let url = format!("{origin}/buzz{path}");
+    let authorization = signed(
+        &keys,
+        &url,
+        &method,
+        &body,
+        vec![
+            vec!["h".into(), channel_id],
+            vec!["relay".into(), relay.clone()],
+            vec![
+                "membership".into(),
+                hex::encode(Sha256::digest(membership.as_bytes())),
+            ],
+        ],
+    )?;
+    let client = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .no_proxy()
+        .timeout(Duration::from_secs(20))
+        .build()
+        .map_err(|_| "Radhouse transport unavailable")?;
+    let parsed_method =
+        reqwest::Method::from_bytes(method.as_bytes()).map_err(|_| "Invalid Radhouse method")?;
+    let mut request = client
+        .request(parsed_method, &url)
+        .header("Origin", &origin)
+        .header("Authorization", authorization)
+        .header("X-Buzz-Membership", membership)
+        .header("X-Radhouse-CSRF", csrf)
+        .header("Content-Type", "application/json");
+    if let Some(cookie) = guard.as_ref().and_then(|session| session.cookie.as_ref()) {
+        request = request.header("Cookie", cookie);
+    }
+    if method == "POST" {
+        request = request.body(body);
+    }
+    let mut response = request
+        .send()
+        .await
+        .map_err(|_| "Radhouse connection interrupted; outcome may be unknown")?;
+    let status = response.status().as_u16();
+    // Only the explicitly named authentication cookie can enter native memory.
+    let cookie = response
+        .headers()
+        .get_all(reqwest::header::SET_COOKIE)
+        .iter()
+        .filter_map(|header| header.to_str().ok())
+        .filter_map(|value| value.split(';').next())
+        .find(|value| value.starts_with("radhouse_session="))
+        .map(str::to_string);
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response
+        .chunk()
+        .await
+        .map_err(|_| "Radhouse response interrupted; outcome may be unknown")?
+    {
+        if bytes.len() + chunk.len() > 1_048_576 {
+            return Err("Radhouse response exceeded its limit".into());
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    if state.signing_keys()?.public_key() != keys.public_key()
+        || relay_api_base_url_with_override(state).trim_end_matches('/') != relay
+    {
+        *guard = None;
+        return Err("The active identity or community changed".into());
+    }
+    if status == 401 || path == "/auth/logout" && status == 204 {
+        if let Some(session) = guard.as_mut() {
+            session.cookie = None;
+        }
+    } else if let Some(cookie) = cookie {
+        if cookie.len() > 160 || cookie.contains(['\r', '\n']) {
+            return Err("Invalid Radhouse session response".into());
+        }
+        if let Some(session) = guard.as_mut() {
+            session.cookie = Some(cookie);
+        }
+    }
+    Ok(RadhouseResponse {
+        status,
+        body: String::from_utf8(bytes).map_err(|_| "Invalid Radhouse response")?,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn key_backup_injection_stops_before_configuration_or_network() {
+        let state = crate::app_state::build_app_state();
+        let result = operator_request(
+            "/tasks".into(),
+            "POST".into(),
+            crate::egress_guard::tests::NCRYPTSEC.into(),
+            "room-1".into(),
+            String::new(),
+            &state,
+        )
+        .await;
+        assert!(matches!(result, Err(message) if message.contains("key-backup material")));
+    }
+    #[test]
+    fn only_operator_routes_are_admitted() {
+        assert!(allowed_path("POST", "/tasks/task-1/permission"));
+        assert!(allowed_path("GET", "/tasks/task-1/events?after=3"));
+        for path in [
+            "https://elsewhere/tasks",
+            "/../admin",
+            "/tasks/%2e%2e/result",
+            "/healthz",
+            "/tasks/id/run",
+            "/tasks/id\\result",
+        ] {
+            assert!(!allowed_path("POST", path));
+        }
+        assert!(!allowed_path("DELETE", "/tasks/id"));
+    }
+
+    #[test]
+    fn native_signature_binds_exact_url_method_body_and_context() {
+        let keys = Keys::generate();
+        let body = r#"{"envelope":{"command_key":"one-command"}}"#;
+        let header = signed(
+            &keys,
+            "https://radhouse.test/buzz/tasks",
+            "POST",
+            body,
+            vec![vec!["h".into(), "room-1".into()]],
+        );
+        assert!(header.is_ok());
+        let Ok(header) = header else {
+            return;
+        };
+        let decoded = BASE64.decode(header.trim_start_matches("Nostr "));
+        assert!(decoded.is_ok());
+        let Ok(decoded) = decoded else {
+            return;
+        };
+        let parsed = nostr::Event::from_json(decoded);
+        assert!(parsed.is_ok());
+        let Ok(event) = parsed else {
+            return;
+        };
+        assert!(event.verify_id() && event.verify_signature());
+        assert_eq!(event.pubkey, keys.public_key());
+        assert_eq!(event.kind, Kind::Custom(27235));
+        let tags: Vec<_> = event
+            .tags
+            .iter()
+            .map(|tag| tag.as_slice().to_vec())
+            .collect();
+        assert!(tags.contains(&vec![
+            "payload".into(),
+            hex::encode(Sha256::digest(body.as_bytes()))
+        ]));
+        assert!(tags.contains(&vec!["h".into(), "room-1".into()]));
+        assert!(tags.contains(&vec!["method".into(), "POST".into()]));
+        assert!(tags.contains(&vec!["u".into(), "https://radhouse.test/buzz/tasks".into()]));
+    }
+}
diff --git a/desktop/src-tauri/src/commands/radhouse/enrollment.rs b/desktop/src-tauri/src/commands/radhouse/enrollment.rs
