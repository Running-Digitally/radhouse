+import { useRelayAgentsQuery } from "@/features/agents/hooks";
+import { externalOwnedAgents } from "@/features/agents/lib/externalOwnedAgents";
+import { useIsArchivedPredicate } from "@/features/identity-archive/hooks";
+import { useUserProfileQuery } from "@/features/profile/hooks";
+import { useIdentityQuery } from "@/shared/api/hooks";
+import type { ManagedAgent, RelayAgent } from "@/shared/api/types";
+import { AgentIdentityCard } from "./AgentIdentityCard";
+import { AgentManagementMarker } from "./OtherSetupAgentMarker";
+
+/** Owned relay identities open the same exact-key profile as their DMs. */
+export function ExternalAgentCards({
+  managed,
+  onOpenProfile,
+}: {
+  managed: ManagedAgent[];
+  onOpenProfile: (pubkey: string) => void;
+}) {
+  const identity = useIdentityQuery();
+  const relay = useRelayAgentsQuery();
+  const isArchived = useIsArchivedPredicate();
+  if (!relay.isSuccess) return null;
+  return externalOwnedAgents(
+    relay.data,
+    managed,
+    identity.data?.pubkey,
+    isArchived,
+  ).map((agent) => (
+    <ExternalAgentCard
+      key={agent.pubkey}
+      agent={agent}
+      onOpenProfile={onOpenProfile}
+    />
+  ));
+}
+
+function ExternalAgentCard({
+  agent,
+  onOpenProfile,
+}: {
+  agent: RelayAgent;
+  onOpenProfile: (pubkey: string) => void;
+}) {
+  const profile = useUserProfileQuery(agent.pubkey);
+  const label = profile.data?.displayName || agent.name;
+  return (
+    <AgentIdentityCard
+      ariaLabel={`${label} agent profile`}
+      dataTestId={`external-agent-${agent.pubkey}`}
+      label={label}
+      avatarUrl={profile.data?.avatarUrl}
+      subtitle={profile.data?.about || "Managed outside this device"}
+      footerAccessory={
+        <AgentManagementMarker
+          pubkey={agent.pubkey}
+          ownerPubkey={agent.ownerPubkey}
+        />
+      }
+      onClick={() => onOpenProfile(agent.pubkey)}
+    />
+  );
+}
