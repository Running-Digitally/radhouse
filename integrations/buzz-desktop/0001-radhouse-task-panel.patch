diff --git a/desktop/src/features/radhouse/RadhousePanel.tsx b/desktop/src/features/radhouse/RadhousePanel.tsx
new file mode 100644
index 0000000..c25e685
--- /dev/null
+++ b/desktop/src/features/radhouse/RadhousePanel.tsx
@@ -0,0 +1,181 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { invalidateChannelState } from "@/features/channels/hooks";
+import { evictUsersBatchEntries } from "@/features/profile/hooks";
+import { relayAgentsQueryKey } from "@/features/agents/hooks";
+import { useAppNavigation } from "@/app/navigation/useAppNavigation";
+import { invokeTauri } from "@/shared/api/tauri";
+import { mountWorkHome } from "@/shared/radhouse/app";
+import { operatorClient } from "@/shared/radhouse/api";
+import type { Transport } from "@/shared/radhouse/api";
+import styles from "@/shared/radhouse/styles.css?inline";
+import { Button } from "@/shared/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+
+/** Native channel task surface, backed by the same controller as the work home. */
+export function RadhouseButton({
+  channelId,
+  pubkey,
+}: {
+  channelId: string;
+  pubkey: string;
+}) {
+  const [configuration, setConfiguration] = useState<{
+    origin: string;
+    relay: string;
+  } | null>(null);
+  const [open, setOpen] = useState(false);
+  const { goChannel } = useAppNavigation();
+  const openConversation = useCallback(
+    async (channel: string) => {
+      setOpen(false);
+      await goChannel(channel);
+    },
+    [goChannel],
+  );
+  useEffect(() => {
+    let current = true;
+    void invokeTauri<{ origin: string; relay: string }>("radhouse_config")
+      .then((value) => {
+        if (current) setConfiguration(value);
+      })
+      .catch(() => {
+        if (current) setConfiguration(null);
+      });
+    return () => {
+      current = false;
+    };
+  }, []);
+  if (!configuration) return null;
+  return (
+    <>
+      <Button
+        type="button"
+        size="sm"
+        variant="outline"
+        onClick={() => setOpen(true)}
+      >
+        Review work
+      </Button>
+      <Dialog open={open} onOpenChange={setOpen}>
+        <DialogContent className="max-w-6xl h-[85vh] flex flex-col overflow-hidden">
+          <DialogTitle>Researcher · work and decisions</DialogTitle>
+          <DialogDescription>
+            Review results and decisions for your Radhouse agent.
+          </DialogDescription>
+          {open && (
+            <TaskSurface
+              key={`${pubkey}:${channelId}`}
+              channelId={channelId}
+              pubkey={pubkey}
+              onOpenConversation={openConversation}
+            />
+          )}
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
+
+function TaskSurface({
+  channelId,
+  pubkey,
+  onOpenConversation,
+}: {
+  channelId: string;
+  pubkey: string;
+  onOpenConversation: (channel: string) => Promise<void>;
+}) {
+  const host = useRef<HTMLDivElement>(null);
+  const queryClient = useQueryClient();
+  useEffect(() => {
+    let current = true;
+    const node = host.current;
+    if (!node) return;
+    const shadow = node.shadowRoot ?? node.attachShadow({ mode: "open" });
+    const style = document.createElement("style");
+    style.textContent =
+      styles.replace(":root", ":host") +
+      "\n:host { display:block; } .shell { padding:1rem 0 2rem; } .page-title { font-size:2.25rem; }";
+    const page = document.createElement("main");
+    page.className = "shell";
+    shadow.replaceChildren(style, page);
+    const transport: Transport = async (path, init) => {
+      const headers = new Headers(init.headers);
+      const result = await invokeTauri<{ status: number; body: string }>(
+        "radhouse_request",
+        {
+          path,
+          method: init.method ?? "GET",
+          body: typeof init.body === "string" ? init.body : "",
+          channelId,
+          csrf: headers.get("X-Radhouse-CSRF") ?? "",
+        },
+      );
+      return new Response(result.status === 204 ? null : result.body, {
+        status: result.status,
+      });
+    };
+    const dispose = mountWorkHome(page, operatorClient(transport, "buzz"), {
+      controlsOnly: true,
+      enrollAgent: async (candidate, session) => {
+        if (candidate.ready && candidate.channel_id) {
+          await onOpenConversation(candidate.channel_id);
+          return;
+        }
+        const receipt = await invokeTauri<{
+          ready: boolean;
+          channel_id: string;
+        }>("radhouse_enroll_agent", {
+          linkId: candidate.link_id,
+          channelId,
+          conversationId: session.conversation_id,
+          bindingRevision: session.binding_revision,
+          csrf: session.csrf_token,
+        });
+        if (!receipt.ready)
+          throw new Error("Researcher connection is incomplete");
+        if (!current)
+          throw new Error(
+            "Researcher connected; reopen Review work in this community.",
+          );
+        // The DM was opened before the agent published its profile. Evict
+        // that confirmed-missing entry before aggregate queries refresh.
+        const agentKey = candidate.agent_pubkey.toLowerCase();
+        const containsAgent = (query: { queryKey: readonly unknown[] }) =>
+          (query.queryKey[0] === "user-profile" ||
+            query.queryKey[0] === "users-batch") &&
+          query.queryKey.includes(agentKey);
+        await queryClient.cancelQueries({ predicate: containsAgent });
+        if (!current) return;
+        evictUsersBatchEntries(queryClient, [agentKey]);
+        await Promise.all([
+          queryClient.invalidateQueries({ queryKey: relayAgentsQueryKey }),
+          queryClient.invalidateQueries({
+            queryKey: ["user-profile", agentKey],
+          }),
+          invalidateChannelState(queryClient, receipt.channel_id),
+          queryClient.invalidateQueries({
+            predicate: (query) =>
+              query.queryKey[0] === "users-batch" &&
+              query.queryKey.includes(agentKey),
+          }),
+        ]);
+        if (current) await onOpenConversation(receipt.channel_id);
+      },
+    });
+    return () => {
+      current = false;
+      dispose();
+      void invokeTauri("radhouse_clear_session", { pubkey }).catch(
+        () => undefined,
+      );
+    };
+  }, [channelId, pubkey, onOpenConversation, queryClient]);
+  return <div ref={host} className="flex-1 min-h-0 overflow-y-auto" />;
+}
