+}
+.button--secondary {
+  border-color: var(--line);
+  background: var(--paper);
+  color: var(--ink);
+}
+.agent-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
+  gap: 12px;
+}
+.agent-card,
+.task-card {
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  background: var(--paper);
+  box-shadow: 0 7px 20px rgb(55 49 34 / 6%);
+}
+.agent-card {
+  padding: 18px;
+}
+.agent-card__name,
+.agent-card__role {
+  margin: 0;
+}
+.agent-card__role {
+  margin-top: 5px;
+  color: var(--green);
+}
+.agent-card .muted {
+  margin-bottom: 0;
+  font-size: 0.86rem;
+}
+.task-list {
+  display: grid;
+  gap: 14px;
+}
+.task-card {
+  padding: 20px;
+}
+.task-card__heading {
+  display: flex;
+  gap: 16px;
+  justify-content: space-between;
+  align-items: start;
+}
+.task-card__title {
+  margin: 0;
+  max-width: 740px;
+  font-size: 1.05rem;
+  line-height: 1.45;
+}
+.task-card__context {
+  margin: 9px 0 0;
+  color: var(--muted);
+  font-size: 0.86rem;
+}
+.phase {
+  flex: none;
+  border-radius: 999px;
+  padding: 5px 9px;
+  background: #e6eee9;
+  color: var(--green-dark);
+  font-size: 0.76rem;
+  font-weight: 750;
+}
+.phase--recovering,
+.phase--stopping {
+  background: #f8e7d8;
+  color: #7e4325;
+}
+.phase--closed {
+  background: #eceae3;
+  color: #5d625c;
+}
+.blockers {
+  margin: 14px 0 0;
+  padding-left: 20px;
+  color: #7e4325;
+}
+.blockers__item + .blockers__item {
+  margin-top: 5px;
+}
+.task-card__actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 16px;
+}
+.result {
+  max-height: 340px;
+  overflow: auto;
+  margin: 16px 0 0;
+  border: 1px solid #d8dcd5;
+  border-radius: 12px;
+  background: #f2f5f0;
+  padding: 14px;
+  white-space: pre-wrap;
+  font:
+    0.9rem / 1.55 ui-monospace,
+    SFMono-Regular,
+    Menlo,
+    monospace;
+}
+.review-panel {
+  margin-top: 18px;
+  border-top: 1px solid var(--line);
+  padding-top: 18px;
+}
+.review-panel__title {
+  margin: 0;
+}
+.notice {
+  margin: 14px 0;
+  border-radius: 12px;
+  padding: 12px 14px;
+  background: #e7efe9;
+  color: var(--green-dark);
+}
+.notice--error {
+  background: #f8e2dc;
+  color: #7c3528;
+}
+.empty,
+.loading {
+  border: 1px dashed #c9c1ae;
+  border-radius: 14px;
+  padding: 22px;
+  color: var(--muted);
+  text-align: center;
+}
+.project-picker {
+  margin-top: 18px;
+  max-width: 24rem;
+}
+.audience-choice {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 10px 0;
+}
+.digest {
+  color: var(--muted);
+  font:
+    0.78rem / 1.5 ui-monospace,
+    monospace;
+  overflow-wrap: anywhere;
+}
+.download {
+  display: inline-flex;
+  text-decoration: none;
+  margin-top: 12px;
+  align-items: center;
+}
+.review-panel > .button + .button {
+  margin-left: 8px;
+}
+.history-panel {
+  margin-top: 20px;
+  border-top: 1px solid var(--line);
+  padding-top: 18px;
+}
+.timeline {
+  border-left: 2px solid var(--line);
+  padding-left: 24px;
+  color: var(--muted);
+}
+.timeline li {
+  padding: 5px 0;
+}
+button:focus-visible,
+a:focus-visible {
+  outline: 3px solid #b86635;
+  outline-offset: 3px;
+}
+
+@media (max-width: 760px) {
+  .shell {
+    width: min(100% - 22px, 1080px);
+    padding-top: 28px;
+  }
+  .start-form {
+    grid-template-columns: 1fr;
+  }
+  .start-form .button {
+    width: 100%;
+  }
+  .task-card__heading {
+    display: grid;
+  }
+  .phase {
+    justify-self: start;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto;
+  }
+}
+
+.conversation-panel {
+  margin: 1.5rem 0;
+  padding: 1.5rem;
+  border: 1px solid var(--border, #d8ddd7);
+  border-radius: 1.25rem;
+  background: var(--surface, #fff);
+}
+.conversation-heading {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin-bottom: 1rem;
+}
+.agent-avatar {
+  display: grid;
+  place-items: center;
+  width: 2.75rem;
+  height: 2.75rem;
+  border-radius: 50%;
+  background: #294c43;
+  color: #fff;
+  font-size: 1.25rem;
+}
+.conversation-messages {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  max-height: 34rem;
+  overflow-y: auto;
+  padding: 0.5rem;
+}
+.conversation-message {
+  max-width: 88%;
+  align-self: flex-start;
+  padding: 1rem 1.25rem;
+  border-radius: 1rem;
+  background: #f0f3ee;
+  overflow-wrap: anywhere;
+}
+.conversation-message--own {
+  align-self: flex-end;
+  background: #e4eee9;
+}
+.message-author {
+  margin: 0 0 0.5rem;
+  font-size: 0.85rem;
+  font-weight: 650;
+}
+.message-content {
+  margin: 0;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  font: inherit;
+}
+.message-controls,
+.conversation-history-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem;
+  margin-top: 0.75rem;
+}
+.message-controls .button {
+  padding: 0.3rem 0.55rem;
+  font-size: 0.8rem;
+}
+.message-reference {
+  margin-top: 0.75rem;
+}
+.conversation-compose {
+  display: grid;
+  gap: 0.75rem;
+  margin-top: 1.5rem;
+}
+.conversation-compose > .button {
+  justify-self: start;
+}
+@media (max-width: 40rem) {
+  .conversation-panel {
+    padding: 0.75rem;
+  }
+  .conversation-message {
+    max-width: 96%;
+  }
+}
diff --git a/desktop/src/shared/radhouse/types.ts b/desktop/src/shared/radhouse/types.ts
