index 0000000..eed5de6
--- /dev/null
+++ b/desktop/src-tauri/src/commands/radhouse/enrollment.rs
@@ -0,0 +1,174 @@
+//! Owner-side enrollment of an exact controller-configured external agent.
+//! Only public signatures leave the signer; no agent runtime is launched here.
+
+use nostr::{EventBuilder, Keys, Kind, PublicKey, Tag};
+use serde::{Deserialize, Serialize};
+use tauri::State;
+
+use crate::app_state::AppState;
+use crate::relay::{
+    assert_expected_relay_scope, assert_expected_signer, submit_signed_event_at_with_keys,
+};
+
+#[derive(Deserialize)]
+struct Candidate {
+    link_id: String,
+    agent_pubkey: String,
+    owner_pubkey: String,
+    display_name: String,
+}
+
+#[derive(Deserialize, Serialize)]
+/// Public receipt used to open the enrolled agent's ordinary Buzz DM.
+pub struct EnrollmentReceipt {
+    link_id: String,
+    channel_id: String,
+    agent_pubkey: String,
+    ready: bool,
+}
+
+fn owner_signatures(
+    keys: &Keys,
+    candidate: &Candidate,
+) -> Result<(nostr::Event, Vec<String>), String> {
+    if candidate.owner_pubkey != keys.public_key().to_hex()
+        || candidate.agent_pubkey == candidate.owner_pubkey
+        || candidate.display_name.is_empty()
+        || candidate.display_name.len() > 200
+    {
+        return Err("The configured Researcher identity does not match this owner".into());
+    }
+    let agent =
+        PublicKey::from_hex(&candidate.agent_pubkey).map_err(|_| "Invalid Researcher key")?;
+    let auth = buzz_sdk_pkg::nip_oa::compute_auth_tag(keys, &agent, "")
+        .map_err(|_| "Could not attest Researcher ownership")?;
+    let attestation = serde_json::from_str(&auth).map_err(|_| "Invalid ownership attestation")?;
+    let content = serde_json::json!({"name": candidate.display_name, "parallelism": 1, "respond_to": "owner-only"});
+    let tag =
+        Tag::parse(["d", candidate.agent_pubkey.as_str()]).map_err(|_| "Invalid Researcher tag")?;
+    let event = EventBuilder::new(Kind::Custom(30177), content.to_string())
+        .tags([tag])
+        .sign_with_keys(keys)
+        .map_err(|_| "Could not sign Researcher discovery")?;
+    Ok((event, attestation))
+}
+
+/// Enroll one preconfigured external agent using the current owner's native key.
+#[tauri::command]
+pub async fn radhouse_enroll_agent(
+    link_id: String,
+    channel_id: String,
+    conversation_id: String,
+    binding_revision: u64,
+    csrf: String,
+    state: State<'_, AppState>,
+) -> Result<EnrollmentReceipt, String> {
+    if !super::identifier(&link_id) || !super::identifier(&conversation_id) || binding_revision == 0
+    {
+        return Err("Invalid Researcher enrollment".into());
+    }
+    let (_, relay, _) = super::config()?;
+    let keys = state.signing_keys()?;
+    let owner = keys.public_key().to_hex();
+    let path = format!(
+        "/agent-enrollment?conversation_id={conversation_id}&binding_revision={binding_revision}"
+    );
+    let response = super::operator_request(
+        path,
+        "GET".into(),
+        String::new(),
+        channel_id.clone(),
+        csrf.clone(),
+        &state,
+    )
+    .await?;
+    if response.status != 200 {
+        return Err("Sign in to Radhouse before connecting Researcher".into());
+    }
+    let candidates: Vec<Candidate> =
+        serde_json::from_str(&response.body).map_err(|_| "Invalid enrollment candidates")?;
+    if candidates.len() > 20 {
+        return Err("Too many enrollment candidates".into());
+    }
+    let candidate = candidates
+        .iter()
+        .find(|item| item.link_id == link_id)
+        .ok_or("Researcher is not configured for this owner")?;
+    let (directory, attestation) = owner_signatures(&keys, candidate)?;
+    assert_expected_relay_scope(
+        Some(&relay),
+        &crate::relay::relay_api_base_url_with_override(&state),
+    )?;
+    assert_expected_signer(Some(&owner), &state.signing_keys()?.public_key().to_hex())?;
+    let dm = super::super::dms::open_dm_with_scope(
+        vec![candidate.agent_pubkey.clone()],
+        Some(&relay),
+        Some(&owner),
+        &state,
+    )
+    .await?;
+    let published = submit_signed_event_at_with_keys(&directory, &state, &relay, &keys).await?;
+    if !published.accepted || published.event_id != directory.id.to_hex() {
+        return Err("Researcher discovery was not confirmed; retry to finish connecting".into());
+    }
+    assert_expected_relay_scope(
+        Some(&relay),
+        &crate::relay::relay_api_base_url_with_override(&state),
+    )?;
+    assert_expected_signer(Some(&owner), &state.signing_keys()?.public_key().to_hex())?;
+    let command = uuid::Uuid::new_v4().to_string();
+    let body = serde_json::json!({"link_id": link_id, "channel_id": dm.id, "attestation": attestation,
+        "envelope": {"channel": "buzz", "event_id": command, "command_key": command,
+            "conversation_id": conversation_id, "binding_revision": binding_revision, "mirrored": false}});
+    let response = super::operator_request(
+        "/agent-enrollment".into(),
+        "POST".into(),
+        body.to_string(),
+        channel_id,
+        csrf,
+        &state,
+    )
+    .await?;
+    if response.status != 200 {
+        return Err("Researcher connection is incomplete. Confirm your Radhouse sign-in and retry; the same private DM will be reused.".into());
+    }
+    let receipt: EnrollmentReceipt =
+        serde_json::from_str(&response.body).map_err(|_| "Invalid Researcher receipt")?;
+    if receipt.link_id != link_id
+        || receipt.channel_id != dm.id
+        || receipt.agent_pubkey != candidate.agent_pubkey
+        || !receipt.ready
+    {
+        return Err("Researcher connection could not be verified".into());
+    }
+    Ok(receipt)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn owner_signs_only_discovery_and_attestation_for_configured_agent() {
+        let owner = Keys::generate();
+        let agent = Keys::generate();
+        let candidate = Candidate {
+            link_id: "researcher".into(),
+            agent_pubkey: agent.public_key().to_hex(),
+            owner_pubkey: owner.public_key().to_hex(),
+            display_name: "Researcher".into(),
+        };
+        let (event, attestation) = owner_signatures(&owner, &candidate).unwrap();
+        assert_eq!(event.kind, Kind::Custom(30177));
+        assert_eq!(event.pubkey, owner.public_key());
+        event.verify().unwrap();
+        let verified = buzz_sdk_pkg::nip_oa::verify_auth_tag(
+            &serde_json::to_string(&attestation).unwrap(),
+            &agent.public_key(),
+        )
+        .unwrap();
+        assert_eq!(verified, owner.public_key());
+        assert!(!event.content.contains(&owner.secret_key().to_secret_hex()));
+        assert!(owner_signatures(&Keys::generate(), &candidate).is_err());
+    }
+}
