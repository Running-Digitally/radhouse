@@ -0,0 +1,50 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { externalOwnedAgents } from "./externalOwnedAgents.ts";
+
+const owner = "ab".repeat(32);
+const remote = { pubkey: "a7".repeat(32), ownerPubkey: owner };
+const other = { pubkey: "b8".repeat(32), ownerPubkey: "cd".repeat(32) };
+const local = { pubkey: "c9".repeat(32), ownerPubkey: owner };
+
+test("owned relay agent appears without manufacturing a managed runtime", () => {
+  assert.deepEqual(
+    externalOwnedAgents([remote], [], owner, () => false),
+    [remote],
+  );
+});
+test("unknown owner, foreign ownership, local duplicates and archives stay absent", () => {
+  const candidates = [remote, other, local, { pubkey: "d0".repeat(32) }];
+  assert.deepEqual(
+    externalOwnedAgents(candidates, [local], undefined, () => false),
+    [],
+  );
+  assert.deepEqual(
+    externalOwnedAgents(candidates, [local], owner, () => false),
+    [remote],
+  );
+  assert.deepEqual(
+    externalOwnedAgents(
+      candidates,
+      [local],
+      owner,
+      (key) => key === remote.pubkey,
+    ),
+    [],
+  );
+});
+test("normalized keys deduplicate relay and local inventory", () => {
+  const upper = {
+    ...remote,
+    pubkey: remote.pubkey.toUpperCase(),
+    ownerPubkey: owner.toUpperCase(),
+  };
+  assert.deepEqual(
+    externalOwnedAgents([remote, upper], [], owner, () => false),
+    [remote],
+  );
+  assert.deepEqual(
+    externalOwnedAgents([remote], [upper], owner, () => false),
+    [],
+  );
+});
diff --git a/desktop/src/features/agents/lib/externalOwnedAgents.ts b/desktop/src/features/agents/lib/externalOwnedAgents.ts
