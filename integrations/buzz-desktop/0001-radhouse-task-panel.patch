index 0000000..083091c
--- /dev/null
+++ b/desktop/src/features/agents/lib/externalOwnedAgents.ts
@@ -0,0 +1,28 @@
+import { normalizePubkey } from "@/shared/lib/pubkey";
+
+/** Relay-confirmed owned identities with no locally managed record. */
+export function externalOwnedAgents<
+  T extends { pubkey: string; ownerPubkey?: string | null },
+>(
+  relay: readonly T[],
+  managed: readonly { pubkey: string }[],
+  owner: string | undefined,
+  isArchived: (pubkey: string) => boolean,
+): T[] {
+  if (!owner) return [];
+  const local = new Set(managed.map((agent) => normalizePubkey(agent.pubkey)));
+  const seen = new Set<string>();
+  return relay.filter((agent) => {
+    const key = normalizePubkey(agent.pubkey);
+    if (
+      !agent.ownerPubkey ||
+      normalizePubkey(agent.ownerPubkey) !== normalizePubkey(owner) ||
+      local.has(key) ||
+      seen.has(key) ||
+      isArchived(key)
+    )
+      return false;
+    seen.add(key);
+    return true;
+  });
+}
