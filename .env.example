# Private release profile. Values are placeholders, never installation details.
# Create .env with: python3 scripts/release.py init-profile
# Parser accepts literal KEY=value only: no quotes, substitutions or shell commands.
# Copy the private profile to the attended target with mode 0600 before apply.
RADHOUSE_RELEASE_ROOT=/srv/example-app/releases
RADHOUSE_EVIDENCE_ROOT=/srv/example-private/release-evidence
RADHOUSE_API_UNIT_FILE=/etc/systemd/system/radhouse-api.service
RADHOUSE_BASELINE_REVISION=REPLACE_FULL_40_CHARACTER_BASELINE_COMMIT
RADHOUSE_API_UNIT_SHA256=REPLACE_SHA256_OF_BASELINE_API_UNIT
RADHOUSE_MACHINE_ID_FILE=/etc/machine-id
RADHOUSE_MACHINE_ID_SHA256=REPLACE_SHA256_OF_MACHINE_ID_FILE_BYTES
RADHOUSE_SERVICE_USER=example_app
RADHOUSE_SERVICE_GROUP=example_app
RADHOUSE_SERVICE_UID=REPLACE_NON_ROOT_SERVICE_UID
RADHOUSE_SQLITE_FILE=/srv/example-data/chat.sqlite3
RADHOUSE_SQLITE_SCHEMA_SHA256=REPLACE_SHA256_OF_REVIEWED_SQLITE_SCHEMA
RADHOUSE_ORIGINALS_DIR=/srv/example-data/originals
RADHOUSE_HTTPS_ORIGIN=https://app.example.invalid:8443
RADHOUSE_TLS_CA_FILE=/etc/example-app/tls/ca.crt
RADHOUSE_CONTROLS_FILE=/etc/example-app/release-controls.json
RADHOUSE_CONTROLS_SHA256=REPLACE_SHA256_OF_PRIVATE_CONTROL_MANIFEST
# Optional file of private identifiers to reject during source packaging.
# RADHOUSE_PRIVATE_IDENTIFIERS_FILE=/etc/example-app/private-identifiers.txt
# Credentials stay in protected files referenced by the existing API config.
# Do not add literal credentials to this profile or to .env.example.
# Optional unchanged qualified vendor tree outside src/radhouse/.
# The private JSON object maps only vendor/... files to their SHA-256 digests.
# RADHOUSE_RETAINED_FILES_FILE=/etc/example-app/retained-runtime-files.json
# RADHOUSE_RETAINED_FILES_SHA256=REPLACE_SHA256_OF_PRIVATE_RETAINED_MANIFEST
