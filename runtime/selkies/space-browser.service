[Unit]
Description=Radhouse browser execution inside a dedicated SPACE microVM
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/unshare --mount --fork /usr/bin/python3 /opt/radhouse-space-bootstrap.py
EnvironmentFile=/etc/radhouse-space-browser.env
Environment=HOME=/home/radhouse LANG=C.UTF-8 PATH=/usr/local/bin:/usr/bin:/bin
MemoryMax=2600M
TasksMax=4096
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
