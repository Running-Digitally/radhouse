+"""Optional Runs ceiling on attempts by one primary OpenAI HTTP client family.
+
+Runs never resumes an orphaned agent. An in-memory counter therefore enforces the
+ceiling without a second journal; an orphan's exact attempt count stays unknown.
+"""
+import hashlib
+import json
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+from threading import Lock
+from urllib.parse import urlsplit
+
+
+_response_observation = ContextVar("capped_response_observation", default=None)
+_REASONS = frozenset({"stop", "length", "tool_calls", "function_call", "content_filter",
+                      "end_turn", "max_tokens", "tool_use", "stop_sequence", "error"})
+
+
+def _field(value, name):
+    return value.get(name) if isinstance(value, dict) else getattr(value, name, None)
+
+
+def _integer(value):
+    return value if type(value) is int and value >= 0 else None
+
+
+def _reason(value):
+    if value is None or type(value) is int:
+        return value
+    return value if isinstance(value, str) and value in _REASONS else "other"
+
+
+def _response_shape(response):
+    """Read scalars only; malformed/hostile properties never change execution."""
+    try:
+        choices = _field(response, "choices")
+        if not isinstance(choices, (list, tuple)) or len(choices) != 1:
+            return {"observed": False}
+        choice = choices[0]
+        message = _field(choice, "message")
+        if message is None:
+            return {"observed": False}
+        usage = _field(response, "usage")
+        content = _field(message, "content")
+        tools = _field(message, "tool_calls")
+        lengths = {name + "_chars": len(value) if isinstance(value, str) else None
+                   for name in ("content", "reasoning", "reasoning_content")
+                   for value in [_field(message, name)]}
+        return {"observed": True, "finish_reason": _reason(_field(choice, "finish_reason")),
+                "stop_reason": _reason(_field(choice, "stop_reason")),
+                "content_kind": "null" if content is None else "string" if isinstance(content, str) else "other",
+                **lengths, "tool_call_count": 0 if tools is None else len(tools) if isinstance(tools, (list, tuple)) else None,
+                "prompt_tokens": _integer(_field(usage, "prompt_tokens")),
+                "completion_tokens": _integer(_field(usage, "completion_tokens")),
+                "total_tokens": _integer(_field(usage, "total_tokens"))}
+    except Exception:
+        return {"observed": False}
+
+
+def _request_shape(request, body):
+    try:
+        url = urlsplit(str(request.url))
+        if url.scheme not in {"http", "https"} or not url.hostname:
+            return {"observed": False}
+        path = url.path
+        digest = lambda value: hashlib.sha256(json.dumps(
+            value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()
+        return {"observed": True, "scheme": url.scheme, "host": url.hostname, "port": url.port,
+                "path": path if path in {"/v1/chat/completions", "/chat/completions"} else None,
+                "path_sha256": hashlib.sha256(path.encode()).hexdigest(),
+                "stream": body.get("stream", False) if type(body.get("stream", False)) is bool else None,
+                **{name + "_sha256": digest(body.get(name)) for name in ("model", "messages", "tools")}}
+    except Exception:
+        return {"observed": False}
+
+
+@contextmanager
+def response_observation(agent, *, fresh=False):
+    """Only ordinal state crosses the existing copied worker Context, never bodies."""
+    token = None
+    try:
+        budget = getattr(agent, "_provider_request_budget", None)
+        current = _response_observation.get()
+        if isinstance(budget, ProviderRequestBudget) and (fresh or current is None or current[0] is not budget):
+            token = _response_observation.set((budget, {"ordinal": None}))
+    except Exception:
+        pass
+    try:
+        yield
+    finally:
+        if token is not None:
+            _response_observation.reset(token)
+
+
+def observe_response(agent, phase, response):
+    """Observation is best-effort and cannot turn a successful call into an error."""
+    try:
+        current = _response_observation.get()
+        budget = getattr(agent, "_provider_request_budget", None)
+        if current is not None and current[0] is budget:
+            budget.observe_response(current[1]["ordinal"], phase, response)
+    except Exception:
+        pass
+
+
+class ProviderRequestBudgetExceeded(RuntimeError):
+    pass
+
+
+def resolve_profile_request_limit(requested: int | None) -> int | None:
+    """Fresh Runs require explicit readable config; replay does not call this.
+
+Without a separate persisted marker, treating a missing/empty profile as defaults
+could silently remove its configured ceiling. A nonempty config with no ceiling
+still permits the upstream uncapped behavior.
+    """
+    from hermes_cli.config import require_readable_config_before_write
+    from hermes_cli.managed_scope import apply_managed_overlay
+    try:
+        # Despite its name this helper only reads and returns the raw mapping.
+        config = require_readable_config_before_write()
+        if not config:
+            raise ValueError("empty or missing config")
+        config = apply_managed_overlay(config)
+    except Exception as exc:
+        raise ValueError("provider_request_budget_config_unavailable") from exc
+    settings = config.get("agent", {})
+    if not isinstance(settings, dict):
+        raise ValueError("provider_request_budget_config_invalid")
+    if "max_provider_requests" not in settings:
+        return requested
+    ceiling = settings["max_provider_requests"]
+    if type(ceiling) is not int or not 1 <= ceiling <= 16:
+        raise ValueError("provider_request_budget_config_invalid")
+    if requested is not None and requested > ceiling:
+        raise ValueError("provider_request_budget_exceeds_profile_limit")
+    return ceiling if requested is None else requested
+
+
+class ProviderRequestBudget:
+    def __init__(self, limit: int):
+        if type(limit) is not int or not 1 <= limit <= 16:
+            raise ValueError("max_provider_requests must be an integer from 1 through 16")
+        self.limit = limit
+        self._reserved = 0
+        self._exhausted = False
+        self._closed = False
+        self._lock = Lock()
+        self._token_limits = []
+
+    def before_request(self, request) -> None:
+        """httpx invokes this before each send, including SDK retries/redirects."""
+        with self._lock:
+            if self._closed:
+                raise ProviderRequestBudgetExceeded("provider_request_budget_closed")
+            if self._reserved >= self.limit:
+                self._exhausted = True
+                raise ProviderRequestBudgetExceeded("provider_request_budget_exhausted")
+            self._reserved += 1
+            # Retain output-limit scalars and sanitized request shape/digests.
+            # Never retain headers, model/prompt text, or a response/stream body.
+            entry = {"ordinal": self._reserved, "observed": False,
+                     "max_tokens": None, "max_completion_tokens": None,
+                     "request_shape": {"observed": False},
+                     "sdk_response": None, "middleware_response": None}
+            try:
+                body = json.loads(request.content)
+                values = {key: body.get(key) for key in ("max_tokens", "max_completion_tokens")}
+                if all(value is None or type(value) is int for value in values.values()):
+                    entry.update(values, observed=True)
+                entry["request_shape"] = _request_shape(request, body)
+            except Exception:
+                pass  # e.g. an unread streaming body; absence of evidence stays explicit
+            self._token_limits.append(entry)
+            current = _response_observation.get()
+            if current is not None and current[0] is self:
+                current[1]["ordinal"] = self._reserved
+
+    def observe_response(self, ordinal, phase, response):
+        if phase not in {"sdk_response", "middleware_response"}:
+            return
+        shape = _response_shape(response)
+        with self._lock:
+            if self._closed or type(ordinal) is not int or not 1 <= ordinal <= len(self._token_limits):
+                return
+            entry = self._token_limits[ordinal - 1]
+            # Streaming aggregates and finalizers without this seam stay unknown.
+            if entry["request_shape"].get("stream") is not False or entry[phase] is not None:
+                return
+            entry[phase] = shape
+
+    def snapshot(self, *, close: bool = False) -> dict:
+        with self._lock:
+            if close:
+                self._closed = True
+            return {"limit": self.limit, "reserved_attempts": self._reserved,
+                    "exhausted": self._exhausted,
+                    "request_token_limits": deepcopy(self._token_limits)}
+
+
+def require_capped_runtime(agent, config: dict, fallback_model) -> None:
+    """Refuse automatic model consumers outside the qualified primary-client seam.
+
+This does not change tool authority or cap programs launched by tools. A capped
+assignment must separately admit only tools that do not launch auxiliary models.
+"""
+    def section(name):
+        value = config.get(name, {})
+        return value if isinstance(value, dict) else {}
+
+    aux = section("auxiliary")
+    if (agent.api_mode != "chat_completions" or agent.provider == "moa"
+            or section("compression").get("enabled") is not False
+            or section("curator").get("enabled") is not False
+            or any(not isinstance(aux.get(name), dict) or aux[name].get("enabled") is not False
+                   for name in ("title_generation", "background_review"))
+            or section("memory").get("provider")
+            or section("context").get("engine") not in (None, "", "compressor")
+            or fallback_model or config.get("fallback_providers")):
+        raise ValueError("provider_request_budget_runtime_unsupported")
