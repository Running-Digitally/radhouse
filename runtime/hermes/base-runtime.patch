+"""Identified user guidance at ordinary post-tool checkpoints of an API run.
+
+The journal owns receipts, while plaintext stays in this run's memory until the
+existing transcript writer persists it. No request is replayed after uncertainty.
+"""
+from __future__ import annotations
+
+import hashlib
+import threading
+from typing import Protocol
+
+MAX_GUIDANCE_RECEIPTS = 64
+MAX_GUIDANCE_INPUT_BYTES = 16384
+
+
+class GuidanceJournal(Protocol):
+    def reserve_guidance(self, scope, run_id, control_id, input_sha256, *, accepting, reason): ...
+    def transition_guidance(self, run_id, control_ids, *, expected_phase, phase, **fields): ...
+    def settle_guidance(self, run_id, reason): ...
+
+
+class GuidedRequestError(RuntimeError):
+    """A guided request must end without an automatic repeat attempt."""
+
+
+class RunGuidance:
+    def __init__(self, journal: GuidanceJournal, scope: str, run_id: str):
+        self.journal, self.scope, self.run_id = journal, scope, run_id
+        self._lock = threading.Lock()
+        self._closed_reason = None
+        self._pending = []
+        self._batch = []
+        self._phase = None
+        self._request_id = None
+        self._checkpoint_number = 0
+
+    @property
+    def awaiting_response(self) -> bool:
+        return bool(self._batch)
+
+    def submit(self, control_id: str, text: str):
+        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+        with self._lock:
+            outcome, receipt = self.journal.reserve_guidance(
+                self.scope, self.run_id, control_id, digest,
+                accepting=self._closed_reason is None, reason=self._closed_reason)
+            if outcome == "created" and receipt["accepted"]:
+                self._pending.append((control_id, text))
+            return outcome, receipt
+
+    def after_tool_batch(self, *, remaining_iterations: int):
+        with self._lock:
+            if self._closed_reason is not None:
+                return None
+            if not self._pending:
+                return None
+            if remaining_iterations <= 0:
+                self._closed_reason = "iteration_limit"
+                self.journal.settle_guidance(self.run_id, "iteration_limit")
+                self._pending.clear()
+                return None
+            if self._batch:
+                raise GuidedRequestError("guidance_previous_request_unconfirmed")
+            self._batch, self._pending = self._pending, []
+            self._checkpoint_number += 1
+            checkpoint_id = f"{self.run_id}:guidance:{self._checkpoint_number}"
+            self.journal.transition_guidance(
+                self.run_id, self._ids(), expected_phase="queued", phase="prepared",
+                checkpoint_id=checkpoint_id)
+            self._phase = "prepared"
+            # Real user input, framed so send-time outer whitespace normalization
+            # cannot change its leading/trailing bytes. IDs are non-secret correlation.
+            content = "\n\n".join(self._frame(control_id, text) for control_id, text in self._batch)
+            return {"role": "user", "content": content, "display_metadata": {
+                "run_guidance": {"run_id": self.run_id, "checkpoint_id": checkpoint_id,
+                                 "control_ids": self._ids()}}}
+
+    @staticmethod
+    def _frame(control_id, text):
+        return f"[User guidance {control_id}]\n{text}\n[/User guidance {control_id}]"
+
+    def _ids(self):
+        return [control_id for control_id, _ in self._batch]
+
+    def request_started(self, api_request_id: str, request: dict):
+        with self._lock:
+            if not self._batch:
+                return
+            if self._closed_reason is not None:
+                raise GuidedRequestError("guidance_run_stopping")
+            if self._phase != "prepared":
+                raise GuidedRequestError("guided_request_already_attempted")
+            contents = []
+            for message in request.get("messages", []):
+                if not isinstance(message, dict) or message.get("role") != "user":
+                    continue
+                content = message.get("content")
+                if isinstance(content, list):
+                    content = "".join(part.get("text", "") for part in content
+                                      if isinstance(part, dict) and part.get("type") == "text")
+                contents.append(content)
+            if not all(any(isinstance(content, str) and self._frame(cid, text) in content
+                           for content in contents) for cid, text in self._batch):
+                raise GuidedRequestError("guidance_missing_from_request")
+            self.journal.transition_guidance(
+                self.run_id, self._ids(), expected_phase="prepared", phase="request_started",
+                api_request_id=api_request_id)
+            self._request_id, self._phase = api_request_id, "request_started"
+
+    def response_completed(self, api_request_id: str):
+        with self._lock:
+            if not self._batch:
+                return
+            if self._phase != "request_started" or self._request_id != api_request_id:
+                raise GuidedRequestError("guidance_request_confirmation_mismatch")
+            self.journal.transition_guidance(
+                self.run_id, self._ids(), expected_phase="request_started", phase="settled",
+                state="applied")
+            self._phase = "settled"
+            self._batch = []
+
+    def close_admission(self, reason: str):
+        with self._lock:
+            self._closed_reason = reason
+
+    def finish(self, reason: str):
+        with self._lock:
+            self._closed_reason = reason
+            self.journal.settle_guidance(self.run_id, reason)
+            self._pending.clear()
+
+
+def failed_guided_result(agent, messages, api_call_count, reason):
+    """Return through the existing API-loop terminal exit, with no retry/fallback."""
+    agent._run_guidance.finish(reason)
+    return {"final_response": "The guided request stopped without an automatic retry.",
+            "messages": messages, "api_calls": api_call_count, "completed": False,
+            "failed": True, "error": reason, "failure_reason": reason, "failure_retryable": False}
+
+
+def guidance_for(agent) -> RunGuidance | None:
