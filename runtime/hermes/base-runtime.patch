+"""Opt-in Radhouse deployment descriptor; no model or lifecycle actuation."""
+
+import json
+import os
+import re
+import stat
+import time
+from pathlib import Path
+
+CONFIG_PATH = Path("/etc/radhouse/runtime-contract.json")
+HOLD_PATH = Path("/var/lib/radhouse-maintenance/hermes-held.json")
+CONTRACT = "radhouse-runtime-v1"
+HOLD_REASONS = frozenset({"maintenance", "manual_stop", "storage_pressure",
+                          "model_unavailable", "runtime_upgrade"})
+_FIELDS = frozenset({"contract", "bot_id", "profile", "runtime_revision", "provider_binding",
+                     "workspace", "max_parallel_runs", "admission", "hold_reason"})
+
+
+def _unique_object(pairs):
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError("duplicate_runtime_field")
+        value[key] = item
+    return value
+
+
+def read_root_json(path: Path):
+    """The agent's filesystem tools must not manufacture deployment identity or unhold.
+
+    Reject writable/symlink parents and files; only genuine absence is optional.
+    Read one bounded regular file through its checked descriptor.
+    """
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    except FileNotFoundError:
+        return None
+    try:
+        for parent in reversed(path.parents):
+            info = parent.lstat()
+            if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+                raise ValueError("unsafe_runtime_parent")
+        info = os.fstat(fd)
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
+                or info.st_mode & 0o022 or info.st_size > 16384):
+            raise ValueError("unsafe_runtime_file")
+        with os.fdopen(fd, "rb", closefd=False) as source:
+            content = source.read(16385)
+        if len(content) > 16384:
+            raise ValueError("oversize_runtime_file")
+        return json.loads(content, object_pairs_hook=_unique_object)
+    finally:
+        os.close(fd)
+
+
+def validate_config(value):
+    if not isinstance(value, dict) or set(value) != _FIELDS or value["contract"] != CONTRACT:
+        raise ValueError("invalid_runtime_config")
+    for name in ("bot_id", "profile", "runtime_revision", "provider_binding"):
+        if not isinstance(value[name], str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", value[name]):
+            raise ValueError("invalid_runtime_pin")
+    workspace = value["workspace"]
+    if (not isinstance(workspace, str) or not workspace.startswith("/")
+            or ".." in Path(workspace).parts or str(Path(workspace)) != workspace):
+        raise ValueError("invalid_runtime_workspace")
+    if type(value["max_parallel_runs"]) is not int or not 1 <= value["max_parallel_runs"] <= 16:
+        raise ValueError("invalid_runtime_capacity")
+    admission, reason = value["admission"], value["hold_reason"]
+    if (admission not in ("ready", "held", "unavailable")
+            or (admission == "ready" and reason is not None)
+            or (admission != "ready" and reason not in HOLD_REASONS)):
+        raise ValueError("invalid_runtime_admission")
+    return dict(value)
+
+
+def configure(adapter):
+    adapter._runtime_contract_enabled = False
+    adapter._runtime_persistence_failed = False
+    try:
+        value = read_root_json(CONFIG_PATH)
+        if value is None:
+            return
+        adapter._runtime_contract_enabled = True
+        validate_config(value)
+        adapter._run_idempotency_store.enable_observations()
+    except (OSError, ValueError, TypeError, RecursionError):
+        adapter._runtime_contract_enabled = True
+        adapter._runtime_persistence_failed = True
+    except Exception:
+        # An opted-in store that cannot migrate may never fall back to memory/legacy.
+        adapter._runtime_contract_enabled = True
+        adapter._runtime_persistence_failed = True
+
+
+def descriptor(adapter, *, request_profile=None):
+    if not getattr(adapter, "_runtime_contract_enabled", False):
+        return None
+    value = validate_config(read_root_json(CONFIG_PATH))
+    if request_profile is not None and request_profile != value["profile"]:
+        raise ValueError("runtime_profile_mismatch")
+    store = adapter._run_idempotency_store
+    workspace = Path(value["workspace"])
+    retained = (workspace.is_dir() and not workspace.is_symlink() and workspace.resolve() == workspace
+                and os.access(workspace, os.R_OK | os.W_OK | os.X_OK))
+    admission, reason = value["admission"], value["hold_reason"]
+    if read_root_json(HOLD_PATH) is not None:
+        # Hold contents cannot broaden authority; the existing root-owned hold wins.
+        admission, reason = "held", "maintenance"
+    if (getattr(adapter, "_runtime_persistence_failed", False) or not store.durable
+            or not store.observations_enabled or not retained
+            or adapter._max_concurrent_runs != value["max_parallel_runs"]):
+        admission, reason = "unavailable", "runtime_upgrade"
+    return dict(contract=CONTRACT, **{name: value[name] for name in
+                ("bot_id", "profile", "runtime_revision", "provider_binding", "max_parallel_runs")},
+                result_protocol="work-result-v1", observations="durable-sequence-v1",
+                durable_runs=bool(store.durable and store.observations_enabled),
+                durable_workspace=bool(retained), admission=admission, hold_reason=reason,
+                observed_at=int(time.time()), guidance_receipts=bool(store.durable))
+
+
+async def handle_descriptor(adapter, request, *, request_profile=None):
+    from aiohttp import web
