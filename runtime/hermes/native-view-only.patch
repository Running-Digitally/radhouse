+/// Inspect complete bounded headers without consuming the WebSocket handshake.
+/// One TCP peek is insufficient: Origin may arrive in a later segment or after
+/// a large header. Never dispatch until the terminator and syntax are verified.
+pub(super) async fn peek_request_headers(stream: &tokio::net::TcpStream) -> Option<Vec<u8>> {
+    const MAX_HEADERS: usize = 16 * 1024;
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        let mut buf = vec![0u8; MAX_HEADERS];
+        loop {
+            let n = stream.peek(&mut buf).await.ok()?;
+            if n == 0 { return None; }
+            let end = buf[..n].windows(4).position(|w| w == b"\r\n\r\n").map(|i| i + 4)
+                .or_else(|| buf[..n].windows(2).position(|w| w == b"\n\n").map(|i| i + 2));
+            if let Some(end) = end {
+                let text = std::str::from_utf8(&buf[..end]).ok()?;
+                let mut lines = text.lines();
+                let first_line = lines.next()?;
+                if !first_line.bytes().all(|b| (32..=126).contains(&b)) { return None; }
+                let first: Vec<&str> = first_line.split_whitespace().collect();
+                if first.len() != 3 || !first[0].bytes().all(|b| b.is_ascii_uppercase())
+                    || !first[1].starts_with('/') || !matches!(first[2], "HTTP/1.0" | "HTTP/1.1") {
+                    return None;
+                }
+                let mut host_count = 0;
+                for line in lines {
+                    if line.is_empty() { break; }
+                    if line.starts_with(' ') || line.starts_with('\t') { return None; }
+                    let (name, value) = line.split_once(':')?;
+                    if name.is_empty() || !name.bytes().all(|b| b.is_ascii_alphanumeric()
+                        || b"!#$%&'*+-.^_`|~".contains(&b))
+                        || !value.bytes().all(|b| b == b'\t' || (32..=126).contains(&b)) {
+                        return None;
+                    }
+                    if name.eq_ignore_ascii_case("host") {
+                        if value.trim().is_empty() { return None; }
+                        host_count += 1;
+                    }
+                }
+                if host_count != 1 { return None; }
+                return Some(buf[..n].to_vec());
+            }
+            if n == MAX_HEADERS { return None; }
+            // Peek retains bytes for tungstenite. Yield until another segment
+            // arrives, with a fixed outer deadline and bounded allocation.
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    }).await.ok().flatten()
